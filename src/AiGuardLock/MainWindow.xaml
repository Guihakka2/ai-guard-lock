<Window x:Class="AiGuardLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:AiGuardLock"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Tr 'AI Guard Lock — セットアップ', 'AI Guard Lock — Setup'}" Width="660" Height="880" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#F3F6F8" PreviewKeyDown="Window_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28">
            <TextBlock Text="PASSWORD SCREEN COVER" FontSize="12" FontWeight="Bold" Foreground="#087E79" />
            <TextBlock Text="AI Guard Lock" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,6" />
            <TextBlock Text="{local:Tr '作業画面を見守る、透過オーバーレイ。', 'A transparent cover for your work screen.'}" Foreground="#52697A" Margin="0,0,0,22" />
            <Border Background="#FFF3DD" CornerRadius="8" Padding="16" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="{local:Tr '半透明のカバーを、本人確認で解除', 'Release the translucent cover after verification'}" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="{local:Tr 'Windowsロックは使いません。主画面を覆い、背景の処理は停止しません。画面切替やタスクマネージャーは防げないため、第三者への強固なアクセス制限にはなりません。', 'Covers the primary screen without locking Windows or stopping background work. Switching apps and Task Manager remain available. This is not strong access protection against other people.'}" FontSize="13" />
                </StackPanel>
            </Border>
            <RadioButton x:Name="HelloMode" GroupName="UnlockMethod" IsChecked="True" Margin="0,0,0,8">
                <TextBlock Text="{local:Tr 'Windows Helloで解除（指紋・顔・Windows PINなど）', 'Unlock with Windows Hello (fingerprint, face or Windows PIN)'}" />
            </RadioButton>
            <TextBlock x:Name="HelloStatus" Text="{local:Tr 'Windows Helloを確認しています…', 'Checking Windows Hello…'}" FontSize="12" Foreground="#52697A" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="TestHelloButton" Content="{local:Tr 'WindowsのPIN・指紋で本人確認を試す', 'Try Windows PIN or fingerprint verification'}" Click="TestHello_Click" Background="#087E79" Foreground="White" Margin="0,4,0,8" />
            <Button x:Name="CheckHelloButton" Content="{local:Tr '利用可否を再確認', 'Check availability again'}" Click="CheckHello_Click" Margin="0,0,0,16" />
            <RadioButton x:Name="LocalMode" GroupName="UnlockMethod" Margin="0,0,0,12">
                <TextBlock Text="{local:Tr 'アプリ専用のPIN・パスワードで解除', 'Unlock with an app-only PIN or password'}" />
            </RadioButton>
            <StackPanel x:Name="LocalSetupPanel" IsEnabled="{Binding IsChecked, ElementName=LocalMode}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=LocalMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            <Label Content="{local:Tr 'PIN（数字4〜12桁）またはパスワード（8〜128文字）', 'PIN (4–12 digits) or password (8–128 characters)'}" Target="{Binding ElementName=NewPassword}" Padding="0,0,0,6" />
            <PasswordBox x:Name="NewPassword" AutomationProperties.Name="{local:Tr 'PINまたはパスワード', 'PIN or password'}" />
            <Label Content="{local:Tr 'PIN・パスワードの確認', 'Confirm PIN or password'}" Target="{Binding ElementName=ConfirmPassword}" Padding="0,14,0,6" />
            <PasswordBox x:Name="ConfirmPassword" AutomationProperties.Name="{local:Tr 'PIN・パスワードの確認', 'Confirm PIN or password'}" />
            <TextBlock Text="{local:Tr 'このアプリ専用です。WindowsのPINとは連携しません。今回の表示中だけ有効で、保存しません。', 'For this app only; separate from your Windows PIN. Valid for this cover session only and never saved.'}" FontSize="12" Foreground="#52697A" Margin="0,8,0,18" />
            </StackPanel>
            <Label Content="{local:Tr '自動解除', 'Automatic release'}" Target="{Binding ElementName=DurationChoice}" Padding="0,0,0,6" />
            <ComboBox x:Name="DurationChoice" SelectedIndex="0" Padding="10,8" AutomationProperties.Name="{local:Tr '自動解除までの時間', 'Time until automatic release'}">
                <ComboBoxItem Content="{local:Tr 'しない（本人確認で解除）', 'Never (verify to unlock)'}" Tag="0" />
                <ComboBoxItem Content="{local:Tr '2分（動作確認用）', '2 minutes (test)'}" Tag="2" />
                <ComboBoxItem Content="{local:Tr '10分', '10 minutes'}" Tag="10" />
                <ComboBoxItem Content="{local:Tr '60分', '60 minutes'}" Tag="60" />
            </ComboBox>
            <CheckBox x:Name="Acknowledge" Margin="0,20,0,10" VerticalContentAlignment="Center">
                <TextBlock Text="{local:Tr '画面操作を行うAIとは併用できないことと、復旧方法を確認しました。', 'I understand this cannot run alongside AI that controls the screen, and I have read the recovery steps.'}" />
            </CheckBox>
            <TextBlock x:Name="StatusText" Text="{local:Tr '主画面のみ対応。PIN・パスワードを忘れた場合は Ctrl+Alt+Del → タスクマネージャーから AI Guard Lock を終了してください。', 'Primary screen only. If you forget the PIN or password, press Ctrl+Alt+Del, open Task Manager and end AI Guard Lock.'}" Foreground="#52697A" MinHeight="44" Margin="0,4,0,8" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="StartButton" Content="{local:Tr '半透明カバーを開始', 'Start screen cover'}" Background="#087E79" Foreground="White" IsDefault="True" Click="Start_Click" />
            <Button Content="{local:Tr '終了', 'Exit'}" Margin="0,10,0,0" Click="Exit_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
