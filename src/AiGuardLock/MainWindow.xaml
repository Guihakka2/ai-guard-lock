<Window x:Class="AiGuardLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Guard Lock — セットアップ" Width="660" Height="880" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#F3F6F8" PreviewKeyDown="Window_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28">
            <TextBlock Text="PASSWORD SCREEN COVER" FontSize="12" FontWeight="Bold" Foreground="#087E79" />
            <TextBlock Text="AI Guard Lock" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,6" />
            <TextBlock Text="作業画面を見守る、透過オーバーレイ。" Foreground="#52697A" Margin="0,0,0,22" />
            <Border Background="#FFF3DD" CornerRadius="8" Padding="16" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="半透明のカバーを、本人確認で解除" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Windowsロックは使いません。主画面を覆い、背景の処理は停止しません。画面切替やタスクマネージャーは防げないため、第三者への強固なアクセス制限にはなりません。" FontSize="13" />
                </StackPanel>
            </Border>
            <RadioButton x:Name="HelloMode" GroupName="UnlockMethod" IsChecked="True" Margin="0,0,0,8">
                <TextBlock Text="Windows Helloで解除（指紋・顔・Windows PINなど）" />
            </RadioButton>
            <TextBlock x:Name="HelloStatus" Text="Windows Helloを確認しています…" FontSize="12" Foreground="#52697A" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="TestHelloButton" Content="WindowsのPIN・指紋で本人確認を試す" Click="TestHello_Click" Background="#087E79" Foreground="White" Margin="0,4,0,8" />
            <Button x:Name="CheckHelloButton" Content="利用可否を再確認" Click="CheckHello_Click" Margin="0,0,0,16" />
            <RadioButton x:Name="LocalMode" GroupName="UnlockMethod" Margin="0,0,0,12">
                <TextBlock Text="アプリ専用のPIN・パスワードで解除" />
            </RadioButton>
            <StackPanel x:Name="LocalSetupPanel" IsEnabled="{Binding IsChecked, ElementName=LocalMode}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=LocalMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            <Label Content="PIN（数字4〜12桁）またはパスワード（8〜128文字）" Target="{Binding ElementName=NewPassword}" Padding="0,0,0,6" />
            <PasswordBox x:Name="NewPassword" AutomationProperties.Name="PINまたはパスワード" />
            <Label Content="PIN・パスワードの確認" Target="{Binding ElementName=ConfirmPassword}" Padding="0,14,0,6" />
            <PasswordBox x:Name="ConfirmPassword" AutomationProperties.Name="PIN・パスワードの確認" />
            <TextBlock Text="このアプリ専用です。WindowsのPINとは連携しません。今回の表示中だけ有効で、保存しません。" FontSize="12" Foreground="#52697A" Margin="0,8,0,18" />
            </StackPanel>
            <Label Content="自動解除" Target="{Binding ElementName=DurationChoice}" Padding="0,0,0,6" />
            <ComboBox x:Name="DurationChoice" SelectedIndex="0" Padding="10,8" AutomationProperties.Name="自動解除までの時間">
                <ComboBoxItem Content="しない（本人確認で解除）" Tag="0" />
                <ComboBoxItem Content="2分（動作確認用）" Tag="2" />
                <ComboBoxItem Content="10分" Tag="10" />
                <ComboBoxItem Content="60分" Tag="60" />
            </ComboBox>
            <CheckBox x:Name="Acknowledge" Margin="0,20,0,10" VerticalContentAlignment="Center">
                <TextBlock Text="画面操作を行うAIとは併用できないことと、復旧方法を確認しました。" />
            </CheckBox>
            <TextBlock x:Name="StatusText" Text="主画面のみ対応。PIN・パスワードを忘れた場合は Ctrl+Alt+Del → タスクマネージャーから AI Guard Lock を終了してください。" Foreground="#52697A" MinHeight="44" Margin="0,4,0,8" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="StartButton" Content="半透明カバーを開始" Background="#087E79" Foreground="White" IsDefault="True" Click="Start_Click" />
            <Button Content="終了" Margin="0,10,0,0" Click="Exit_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
