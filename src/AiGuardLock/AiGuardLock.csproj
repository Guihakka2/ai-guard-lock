  <ItemGroup>
    <Resource Include="Assets/AppIcon.ico" />
    <ProjectReference Include="../AiGuardLock.Core/AiGuardLock.Core.csproj" />
    <InternalsVisibleTo Include="AiGuardLock.Tests" />
  </ItemGroup>
</Project>
